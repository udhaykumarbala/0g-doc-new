{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "staging.docs.0g.ai" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" },
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" },
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*).md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" },
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*).mdx",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" },
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "redirects": [
    { "source": "/node-sale/intro/intro", "destination": "/node-sale/intro", "permanent": true },
    { "source": "/node-sale/faq/faq", "destination": "/node-sale/faq", "permanent": true },
    { "source": "/0g-storage", "destination": "/concepts/storage", "permanent": true },
    { "source": "/concepts/inft", "destination": "/concepts/agentic-id", "permanent": true },
    { "source": "/developer-hub/building-on-0g/inft", "destination": "/developer-hub/building-on-0g/agentic-id/overview", "permanent": true },
    { "source": "/developer-hub/building-on-0g/inft/inft-overview", "destination": "/developer-hub/building-on-0g/agentic-id/overview", "permanent": true },
    { "source": "/developer-hub/building-on-0g/inft/integration", "destination": "/developer-hub/building-on-0g/agentic-id/integration", "permanent": true },
    { "source": "/developer-hub/building-on-0g/inft/erc7857", "destination": "/developer-hub/building-on-0g/agentic-id/erc7857", "permanent": true }
  ]
}
